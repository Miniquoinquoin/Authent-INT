# Copy to .env (`cp .env.example .env`). Dev values only — never commit a real secret.
# docker-compose.yml sets ISSUER and DATABASE_URL for the container itself; the copies
# below mirror them. Postgres is only reachable on the Docker network (host `postgres`),
# so run DB commands inside the container: `docker compose exec auth-server uv run alembic ...`

# --- read by docker-compose.yml
POSTGRES_PASSWORD=authentint
LOG_LEVEL=INFO

# --- read by apps/auth-server/src/authentint/config.py (Settings)
ISSUER=https://auth.authentint.local
DATABASE_URL=postgresql+asyncpg://authentint_app:authentint@postgres:5432/authentint
# Encrypts signing private keys at rest (ADR §8, signing_keys). Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_KEY=
# Optional — defaults in config.py
# ACCESS_TOKEN_TTL=600
# ID_TOKEN_TTL=300
# OTP_TTL=30

# --- DEV ONLY — fake LDAP directory (10 006 invented users) read by scripts/seed.py.
# docker-compose.dev.yml mounts it read-only at /fixtures and sets DEV=true; config.py
# only uses the fixture when DEV is true. Never enable in production: real users come
# from the client's directory. Optional override of the in-container path:
# FIXTURES_PATH=/fixtures/ldap/users.json

# --- dev only: live reload of apps/auth-server/src (docker-compose.dev.yml).
# Remove this line to run the stack exactly as non-developers do.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
