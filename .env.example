# Every variable config.py reads. Copy to .env — `make up` does it for you.
# Values here are host-facing; docker-compose.yml overrides the three that
# differ inside the network.

# --- infrastructure
DATABASE_URL=postgresql+asyncpg://authentint:authentint@localhost:5432/authentint
POSTGRES_PASSWORD=password # Change this value for obvious security reasons
VALKEY_URL=redis://localhost:6379/0
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@authentint.local

# The one rule that makes inserting Caddy an .env change (§2). Links in mails
# are built from this and never from a literal.
PUBLIC_BASE_URL=http://localhost:5173

# --- directory fixture (§5)
FIXTURE_PATH=fixtures/ldap/users.json

# --- passwords — ANSSI: length, no composition rule. Gated on §17 Q7.
PASSWORD_MIN_LENGTH=12

# --- account lockout (§15)
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_BACKOFF_S=900

# --- rate limits, per IP *and* per account, separately (§15). Fail closed.
RL_LOGIN_IP=10
RL_LOGIN_IP_WINDOW_S=60
RL_LOGIN_ACCOUNT=5
RL_LOGIN_ACCOUNT_WINDOW_S=60
RL_OTP_SEND=3
RL_OTP_SEND_WINDOW_S=600

# --- TTLs (§11b)
INTERACTION_TTL_S=600
OTP_TTL_S=600
OTP_MAX_ATTEMPTS=5
ACTIVATION_TTL_S=1800

# --- session. __Host- requires Secure; localhost is a secure context, so this
# normally works over plain http in dev. If your browser disagrees, drop the
# prefix here — it flips back permanently when Caddy lands.
SESSION_IDLE_TTL_S=1800
SESSION_ABSOLUTE_TTL_S=43200

# --- logs
LOG_LEVEL=INFO

# --- dev only: live reload of apps/auth-server/src (docker-compose.dev.yml).
# Remove this line to run the stack exactly as non-developers do.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
