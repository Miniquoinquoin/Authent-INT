# Every variable config.py reads. Copy to .env — `make up` does it for you.
# Values here are host-facing; docker-compose.yml overrides the three that
# differ inside the network.

# --- infrastructure
DATABASE_URL=postgresql+asyncpg://authentint:authentint@localhost:5432/authentint
VALKEY_URL=redis://localhost:6379/0
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@authentint.local

# The one rule that makes inserting Caddy an .env change (§2). Links in mails
# are built from this and never from a literal.
PUBLIC_BASE_URL=http://localhost:5173

# --- directory fixture (§5)
FIXTURE_PATH=fixtures/ldap/users.json

# --- passwords — ANSSI: length, no composition rule. Gated on §17 Q7.
PASSWORD_MIN_LENGTH=12

# --- account lockout (§15)
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_BACKOFF_S=900

# --- rate limits, per IP *and* per account, separately (§15). Fail closed.
RL_LOGIN_IP=10
RL_LOGIN_IP_WINDOW_S=60
RL_LOGIN_ACCOUNT=5
RL_LOGIN_ACCOUNT_WINDOW_S=60
RL_OTP_SEND=3
RL_OTP_SEND_WINDOW_S=600

# --- TTLs (§11b)
INTERACTION_TTL_S=600
OTP_TTL_S=600
OTP_MAX_ATTEMPTS=5
ACTIVATION_TTL_S=1800

# --- session. The cookie name and its Secure flag are derived from the scheme
# in PUBLIC_BASE_URL, because those two must never disagree: Safari refuses to
# send a Secure cookie over plain http (localhost included) where Chromium
# sends it anyway, so a hardcoded `Secure` works in one browser and dead-ends at
# the dashboard in the other. http -> `authentint_session`, no Secure;
# https -> `__Host-session` with Secure, which is what Caddy will bring.
# Uncomment only to override the derivation.
# SESSION_COOKIE_NAME=__Host-session
# SESSION_COOKIE_SECURE=true
SESSION_IDLE_TTL_S=1800
SESSION_ABSOLUTE_TTL_S=43200

# --- logs
LOG_LEVEL=INFO
