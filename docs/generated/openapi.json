{
  "openapi": "3.1.0",
  "info": {
    "title": "Authent'INT — auth-server",
    "summary": "Authentication core: activation, password login, e-mail OTP, sessions.",
    "version": "0.1.0"
  },
  "paths": {
    "/interaction": {
      "post": {
        "tags": [
          "interaction"
        ],
        "summary": "Start",
        "description": "Mint a `uid`.\n\n**Temporary.** `/authorize` takes this over at S2, after validating\n`client_id`, `redirect_uri` and PKCE (§8 step 7). Everything below it stays.",
        "operationId": "start_interaction_post",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InteractionCreated"
                }
              }
            }
          }
        }
      }
    },
    "/interaction/{uid}": {
      "get": {
        "tags": [
          "interaction"
        ],
        "summary": "State",
        "description": "What does this pending authentication need next?",
        "operationId": "state_interaction__uid__get",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Uid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InteractionState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/interaction/{uid}/login": {
      "post": {
        "tags": [
          "interaction"
        ],
        "summary": "Login",
        "description": "Numéro fiscal + mot de passe.\n\nFive failure branches — unknown, wrong password, awaiting activation,\nlocked, disabled — and all five return the identical body with the identical\nlatency.",
        "operationId": "login_interaction__uid__login_post",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Uid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InteractionState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/interaction/{uid}/mfa/send": {
      "post": {
        "tags": [
          "interaction"
        ],
        "summary": "Mfa Send",
        "description": "E-mail a six-digit code.",
        "operationId": "mfa_send_interaction__uid__mfa_send_post",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Uid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InteractionState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/interaction/{uid}/mfa/verify": {
      "post": {
        "tags": [
          "interaction"
        ],
        "summary": "Mfa Verify",
        "description": "Verify the code, open the session, set the cookie.",
        "operationId": "mfa_verify_interaction__uid__mfa_verify_post",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Uid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InteractionState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/account/activation/confirm": {
      "post": {
        "tags": [
          "account"
        ],
        "summary": "Confirm",
        "description": "Token + chosen password → the account's first password.",
        "operationId": "confirm_account_activation_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivationConfirm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Me",
        "description": "What the session resolves to. The proof the cookie works end to end.",
        "operationId": "me_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        }
      }
    },
    "/logout": {
      "post": {
        "tags": [
          "me"
        ],
        "summary": "Logout",
        "description": "Revoke the row, then clear the cookie.\n\nRevoking first matters: the cookie is a hint, the row is the truth. Clearing\nonly the cookie would leave a live session for anyone who kept a copy.",
        "operationId": "logout_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Live",
        "description": "The process is up. Nothing else is asserted.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Ready",
        "description": "Postgres and Valkey only.\n\nDeliberately **not** the directory: §5b rule 4 — the auth server serves\nlogins without it, and a directory outage must not take readiness with it.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Ready Health Ready Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivationConfirm": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 256,
            "title": "Password"
          },
          "token": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "password",
          "token"
        ],
        "title": "ActivationConfirm"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InteractionCreated": {
        "properties": {
          "uid": {
            "type": "string",
            "title": "Uid"
          }
        },
        "type": "object",
        "required": [
          "uid"
        ],
        "title": "InteractionCreated"
      },
      "InteractionState": {
        "properties": {
          "stage": {
            "type": "string",
            "title": "Stage"
          }
        },
        "type": "object",
        "required": [
          "stage"
        ],
        "title": "InteractionState",
        "description": "What does this pending authentication need next?\n\nThe server decides the stage. The client never carries identity state back\nto us — it cannot tamper with what it does not hold (§7)."
      },
      "LoginRequest": {
        "properties": {
          "numero_fiscal": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Numero Fiscal"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "numero_fiscal",
          "password"
        ],
        "title": "LoginRequest"
      },
      "Me": {
        "properties": {
          "nom": {
            "type": "string",
            "title": "Nom"
          },
          "prenom": {
            "type": "string",
            "title": "Prenom"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "statut": {
            "type": "string",
            "title": "Statut"
          },
          "session_ouverte_a": {
            "type": "string",
            "format": "date-time",
            "title": "Session Ouverte A"
          }
        },
        "type": "object",
        "required": [
          "nom",
          "prenom",
          "role",
          "statut",
          "session_ouverte_a"
        ],
        "title": "Me"
      },
      "MfaVerifyRequest": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 6,
            "minLength": 6,
            "pattern": "^\\d{6}$",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "MfaVerifyRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
