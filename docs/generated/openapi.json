    "/token": {
      "post": {
        "tags": [
          "oidc"
        ],
        "summary": "Issue Tokens",
        "operationId": "issue_tokens_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/TokenBody"
                  },
                  {
                    "$ref": "#/components/schemas/RefreshBody"
                  }
                ],
                "title": "Body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
