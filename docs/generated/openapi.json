    "/account/activation/request": {
      "post": {
        "tags": [
          "interaction",
          "account"
        ],
        "summary": "Request Activation",
        "description": "Always 202 with the same body: whether an e-mail left is never told.",
        "operationId": "request_activation_account_activation_request_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "429": {
            "description": "Rate limited"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/account/activation/confirm": {
      "post": {
        "tags": [
          "interaction",
          "account"
        ],
        "summary": "Confirm Activation",
        "description": "The link's token + the chosen password. The account becomes active.",
        "operationId": "confirm_activation_account_activation_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivationConfirm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Unknown, expired or already used link (same answer for the three)"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/interaction/{uid}": {
      "get": {
        "tags": [
          "interaction"
        ],
        "summary": "Get Interaction",
        "operationId": "get_interaction_interaction__uid__get",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Uid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InteractionView"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or expired uid"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/interaction/{uid}/login": {
      "post": {
        "tags": [
          "interaction"
        ],
        "summary": "Login",
        "description": "On success, sets the `__Host-session` cookie and answers the next step.",
        "operationId": "login_interaction__uid__login_post",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Uid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InteractionView"
                }
              }
            }
          },
          "401": {
            "description": "Bad numero_fiscal or password (same answer for both)"
          },
          "404": {
            "description": "Unknown or expired uid"
          },
          "423": {
            "description": "Account locked"
          },
          "429": {
            "description": "Rate limited"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/interaction/{uid}/consent": {
      "post": {
        "tags": [
          "interaction"
        ],
        "summary": "Consent",
        "description": "approve=false ends the flow: redirect_to then carries error=access_denied.",
        "operationId": "consent_interaction__uid__consent_post",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Uid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InteractionView"
                }
              }
            }
          },
          "400": {
            "description": "Not logged in yet: login comes first"
          },
          "404": {
            "description": "Unknown or expired uid"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/account/password-reset/request": {
      "post": {
        "tags": [
          "interaction",
          "account"
        ],
        "summary": "Request Reset",
        "description": "Always 202 with the same body: whether an e-mail left is never told.",
        "operationId": "request_reset_account_password_reset_request_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "429": {
            "description": "Rate limited"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/account/password-reset/confirm": {
      "post": {
        "tags": [
          "interaction",
          "account"
        ],
        "summary": "Confirm Reset",
        "description": "The link's token + the new password. Every open session of the account is closed.",
        "operationId": "confirm_reset_account_password_reset_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetConfirm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Unknown, expired or already used link (same answer for the three)"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/keys/rotate": {
      "post": {
        "tags": [
          "key"
        ],
        "summary": "Rotate",
        "operationId": "rotate_admin_keys_rotate_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivationConfirm": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Token"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "title": "ActivationConfirm"
      },
      "ActivationRequest": {
        "properties": {
          "numero_fiscal": {
            "type": "string",
            "pattern": "^\\d{13}$",
            "title": "Numero Fiscal"
          }
        },
        "type": "object",
        "required": [
          "numero_fiscal"
        ],
        "title": "ActivationRequest"
      },
      "ConsentBody": {
        "properties": {
          "approve": {
            "type": "boolean",
            "title": "Approve"
          }
        },
        "type": "object",
        "required": [
          "approve"
        ],
        "title": "ConsentBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InteractionView": {
        "properties": {
          "prompt": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "login",
                  "consent"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt",
            "description": "Step to display next. null: finished, follow redirect_to"
          },
          "client_name": {
            "type": "string",
            "title": "Client Name"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Scopes"
          },
          "redirect_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Redirect To",
            "description": "Set when prompt is null: back to /authorize, which issues the code"
          }
        },
        "type": "object",
        "required": [
          "prompt",
          "client_name",
          "scopes"
        ],
        "title": "InteractionView"
      },
      "LoginBody": {
        "properties": {
          "numero_fiscal": {
            "type": "string",
            "pattern": "^\\d{13}$",
            "title": "Numero Fiscal"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "numero_fiscal",
          "password"
        ],
        "title": "LoginBody"
      },
      "RefreshBody": {
        "properties": {
          "grant_type": {
            "type": "string",
            "const": "refresh_token",
            "title": "Grant Type"
          },
          "refresh_token": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Refresh Token"
          },
          "client_id": {
            "type": "string",
            "title": "Client Id"
          },
          "scope": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ],
            "title": "Scope"
          }
        },
        "type": "object",
        "required": [
          "grant_type",
          "refresh_token",
          "client_id"
        ],
        "title": "RefreshBody"
      },
      "ResetConfirm": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Token"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "title": "ResetConfirm"
      },
      "ResetRequest": {
        "properties": {
          "numero_fiscal": {
            "type": "string",
            "pattern": "^\\d{13}$",
            "title": "Numero Fiscal"
          }
        },
        "type": "object",
        "required": [
          "numero_fiscal"
        ],
        "title": "ResetRequest"
      },
      "RevokeBody": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Token"
          },
          "token_type_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Token Type Hint"
          },
          "client_id": {
            "type": "string",
            "title": "Client Id"
          }
        },
        "type": "object",
        "required": [
          "token",
          "client_id"
        ],
        "title": "RevokeBody"
      },
      "TokenBody": {
        "properties": {
          "grant_type": {
            "type": "string",
            "const": "authorization_code",
            "title": "Grant Type"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "redirect_uri": {
            "type": "string",
            "title": "Redirect Uri"
          },
          "client_id": {
            "type": "string",
            "title": "Client Id"
          },
          "code_verifier": {
            "type": "string",
            "maxLength": 128,
            "minLength": 43,
            "title": "Code Verifier"
          }
        },
        "type": "object",
        "required": [
          "grant_type",
          "code",
          "redirect_uri",
          "client_id",
          "code_verifier"
        ],
        "title": "TokenBody"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBasic": {
        "type": "http",
        "scheme": "basic"
      },
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
