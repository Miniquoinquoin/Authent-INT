# Authent'INT — point d'entrée unique de la stack.
#
# Caddy porte les quatre noms d'hôte publics et termine TLS pour tout le monde.
# Les conteneurs internes l'atteignent par les mêmes noms, grâce aux alias
# réseau déclarés sur le réseau `edge` (docs/architecture.md §1.1).

{
	# Autorité de certification interne, générée au premier démarrage dans
	# /data. Pas d'ACME, pas d'Internet : la stack démarre hors ligne.
	local_certs

	# L'API d'administration n'a aucune raison d'être joignable ici.
	admin off
}

# Réglages partagés par les quatre sites.
(commun) {
	encode gzip
	header -Server
	log {
		output stdout
		format console
	}
	request_header X-Request-Id {http.request.uuid}
}

# --- OpenID Provider -------------------------------------------------------
# Ce nom est l'`issuer`. Le navigateur et les conteneurs l'utilisent tel quel.
auth.authentint.localhost {
	tls internal
	import commun
	# /metrics is for scrapers on the docker network only (http://auth-server:8000/metrics):
	# it reveals traffic, error rates and route usage. Same 404 as any unknown path (ADR §9 Ops).
	@metrics path /metrics /metrics/*
	respond @metrics 404
	# The login page is served from the issuer's origin: its __Host-session cookie is then
	# first-party in every browser (Safari treats app. -> auth. under .localhost as cross-site).
	@spa path /login /assets/* /background/* /authent_int_*.png /favicon.ico
	reverse_proxy @spa frontend:80
	reverse_proxy auth-server:8000
}

# --- SPA -------------------------------------------------------------------
app.authentint.localhost {
	tls internal
	import commun
	reverse_proxy frontend:80
}

# --- Resource Servers ------------------------------------------------------
impots.authentint.localhost {
	tls internal
	import commun
	reverse_proxy svc-impots:8001
}

cadastre.authentint.localhost {
	tls internal
	import commun
	reverse_proxy svc-cadastre:8001
}
